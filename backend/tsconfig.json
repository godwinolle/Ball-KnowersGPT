{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "rootDir": "backend/src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["backend/src/app.ts"],
  "exclude": ["node_modules"],
  "ts-node": {
        // Tell ts-node CLI to install the --loader automatically
        "esm": true
  }
}